# Copy to backend/.env and fill the AI settings below.
# scripts/Start-Backend.ps1 loads .env; plain mvn spring-boot:run does not.
# Existing terminal environment variables take precedence. Blank values are ignored.
# Values are literal: KEY=value or KEY="value". Put comments on separate lines.
SPRING_PROFILES_ACTIVE=dev

# Required for Gemini analysis. Select a model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Required for embedding/RAG. Not required for Gemini ticket analysis alone.
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSIONS=1024
RAG_INDEX_DIRECTORY=./data/vectors
RAG_AUTO_SYNC_ENABLED=true
RAG_MINIMUM_SIMILARITY=0.35

# For a later MySQL/VPS deployment, change the profile above to mysql,
# uncomment these, and replace every placeholder before starting.
# DB_URL=jdbc:mysql://localhost:3306/smart_workorder?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
# DB_USERNAME=smart_workorder
# DB_PASSWORD=replace-with-database-password
# JWT_SECRET=replace-with-at-least-32-random-bytes
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-an-initial-admin-password
