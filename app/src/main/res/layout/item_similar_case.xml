<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/bg_badge" android:orientation="vertical">
    <TextView android:id="@+id/title" style="@style/Text.Workorder.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" />
    <TextView android:id="@+id/score" style="@style/Text.Workorder.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/resolution" style="@style/Text.Workorder.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/openCase" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/open_case" />
</LinearLayout>
