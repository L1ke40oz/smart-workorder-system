<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
        <TextView style="@style/Text.Workorder.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:padding="24dp" android:orientation="vertical" android:background="@drawable/bg_hero">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="26sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#D7E5D9" android:textSize="14sp" />
            <TextView android:id="@+id/role" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#D7E5D9" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/roleDescription" style="@style/Text.Workorder.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/bg_card" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logout" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="@string/logout" />
        <TextView style="@style/Text.Workorder.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:gravity="center" android:text="@string/app_name" />
    </LinearLayout>
</ScrollView>
